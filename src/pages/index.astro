---
import Hero from "@/components/Hero.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import BaseHtml from "@/components/BaseHtml.astro";
import Footer from "@/components/Footer.astro";
import WidgetsGrid from "@/components/WidgetsGrid.astro";
import { Icon } from "astro-icon/components";
---

<BaseHtml
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image="/og/index.png"
>
  <Hero />

  <section class="transition-page section-shell pt-6 pb-8">
    <div
      class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      data-reveal
    >
      <div>
        <p
          class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Free · open source
        </p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight md:text-4xl">
          Real screens, not screenshots.
        </h2>
        <p class="text-muted-foreground mt-3 max-w-2xl text-sm md:text-base">
          Every category is a set of Flutter screens running live in your
          browser. Tap through them, flip to the code, and copy what you need.
        </p>
      </div>
      <a
        href="/widgets"
        class="interactive-button border-border bg-card text-foreground hover:bg-muted inline-flex shrink-0 items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold"
        data-swup-preload
      >
        Browse all categories
        <Icon name="mdi:arrow-right" class="interactive-icon-shift h-4 w-4" />
      </a>
    </div>

    <WidgetsGrid />
  </section>

  <section class="transition-page section-shell pb-14">
    <div
      class="bg-primary relative overflow-hidden rounded-3xl p-8 text-white md:p-12 dark:bg-[oklch(0.34_0.1_261)]"
      data-reveal
    >
      <div class="relative max-w-2xl">
        <p class="text-xs font-semibold tracking-widest uppercase opacity-70">
          Premium · starter kits
        </p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight md:text-4xl">
          Skip the first three weeks.
        </h2>
        <p class="mt-4 max-w-xl text-sm opacity-90 md:text-base">
          Complete, production-wired Flutter apps — auth, payments, and a
          backend already solved. Rebrand it and ship. Try the whole thing live
          before you buy.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href="/templates"
            class="interactive-button inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-[oklch(0.42_0.14_261)] hover:opacity-95"
            data-swup-preload
          >
            Browse templates
            <Icon
              name="mdi:arrow-right"
              class="interactive-icon-shift h-4 w-4"
            />
          </a>
          <span
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 px-5 py-3 text-sm font-semibold"
          >
            <Icon name="mdi:flash" class="h-4 w-4" />
            New kits landing soon
          </span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseHtml>
