---
import { SITE_TITLE, GITHUB_URL } from "@/consts";
import Logo from "./Logo.astro";

const currentYear = new Date().getFullYear();

const columns = [
  {
    heading: "Library",
    links: [
      { label: "Widgets", href: "/widgets" },
      { label: "Templates", href: "/templates" },
      { label: "Guides", href: "/guides" },
      { label: "Search", href: "/search" },
    ],
  },
  {
    heading: "Project",
    links: [
      { label: "GitHub", href: GITHUB_URL, external: true },
      { label: "RSS", href: "/rss.xml" },
    ],
  },
];
---

<footer
  class="border-border section-shell mt-8 border-t py-12"
  data-pagefind-ignore
>
  <div class="flex flex-col gap-10 md:flex-row md:justify-between">
    <div class="max-w-sm">
      <Logo />
      <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
        Open-source Flutter screens and templates. Preview them live, then copy
        the source.
      </p>
    </div>

    <div class="flex gap-16">
      {
        columns.map((col) => (
          <div>
            <p class="text-sm font-semibold">
              {col.heading}
            </p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                    {...(link.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="border-border text-muted-foreground mt-10 flex flex-col gap-2 border-t pt-6 text-xs md:flex-row md:items-center md:justify-between"
  >
    <p>© {currentYear} {SITE_TITLE}</p>
    <p>MIT licensed</p>
  </div>
</footer>
