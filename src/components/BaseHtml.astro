---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // Title shown in site search; lets results say what kind of page they are.
  searchTitle?: string;
  // Listing pages are left out of site search.
  searchable?: boolean;
}
const {
  title,
  description,
  image = "/og.png",
  searchTitle,
  searchable = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title ?? SITE_TITLE}
      description={description ?? SITE_DESCRIPTION}
      image={image}
    />
    {searchTitle && <meta data-pagefind-meta={`title:${searchTitle}`} />}
  </head>
  <body>
    <Header />
    <main id="swup" data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
  </body>
</html>
