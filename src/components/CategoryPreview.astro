          <div class="bg-muted mt-1.5 h-1.5 w-2/3 rounded opacity-70" />
        </div>
        <div class="bg-card flex items-center justify-around rounded-xl py-2.5">
          <Icon name="mdi:home" class="text-primary size-4" />
          <Icon
            name="mdi:magnify"
            class="text-muted-foreground motion-safe:group-hover:text-foreground size-4 transition-colors duration-300"
          />
          <Icon
            name="mdi:bell-outline"
            class="text-muted-foreground motion-safe:group-hover:text-foreground size-4 transition-colors delay-75 duration-300"
          />
          <Icon
            name="mdi:account-outline"
            class="text-muted-foreground motion-safe:group-hover:text-foreground size-4 transition-colors delay-100 duration-300"
          />
        </div>
      </div>
    )
  }

  {
    !known.includes(slug) && (
      <div class="flex h-full flex-col justify-center gap-2.5">
        {[70, 56, 62].map((w, i) => (
          <div class="flex items-center gap-2.5">
            <span class="bg-accent text-accent-foreground flex h-8 w-8 flex-none items-center justify-center rounded-lg">
