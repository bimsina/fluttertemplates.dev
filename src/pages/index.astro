---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import AgentSection from "@/components/AgentSection";
import BaseHtml from "@/components/BaseHtml.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import WidgetsGrid from "@/components/WidgetsGrid.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import { getWidgetStats } from "@/utils/get_widget_stats";

const FEATURED_CATEGORIES = [
  "auth",
  "chat",
  "ecommerce",
  "dashboard",
  "forms",
  "ai",
  "social",
  "finance",
  "navigation",
];
const FEATURED_TEMPLATES = ["food-delivery", "banking-wallet", "retail-pos"];

const templates = await getCollection("templates");
const featured = FEATURED_TEMPLATES.flatMap((id) =>
  templates.filter((template) => template.id === id),
);
const { categoryCount } = await getWidgetStats();
---

<BaseHtml
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image="/og/index.png"
  searchable={false}
>
  <Hero />

  <section class="transition-page section-shell py-14 md:py-20">
    <AgentSection client:load />
  </section>

  <section class="transition-page section-shell py-14 md:py-20">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight md:text-4xl">
          Start from a working app.
        </h2>
        <p class="text-muted-foreground mt-3 md:text-lg">
          Run it in your browser, copy the source, connect your backend.
        </p>
      </div>
      <a
        href="/templates/"
        class="text-primary hidden shrink-0 items-center gap-1 text-sm font-semibold sm:inline-flex"
        data-swup-preload
      >
        All templates
        <Icon name="mdi:arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        featured.map((template) => (
          <a
            href={`/templates/${template.id}/`}
            class="border-border bg-card interactive-card group flex flex-col overflow-hidden rounded-2xl border"
            data-swup-preload
          >
            <div class="bg-background aspect-[16/10] overflow-hidden">
              {template.data.heroImage && (
                <Image
                  class="h-full w-full object-cover"
                  src={template.data.heroImage}
                  alt=""
                  loading="lazy"
                />
              )}
            </div>
            <div class="p-5">
              <h3 class="group-hover:text-primary font-semibold tracking-tight transition-colors">
                {template.data.title}
              </h3>
              <p class="text-muted-foreground mt-1.5 text-sm">
                {template.data.summary}
              </p>
            </div>
          </a>
        ))
      }
    </div>
    <a
      href="/templates/"
      class="text-primary mt-5 inline-flex items-center gap-1 text-sm font-semibold sm:hidden"
    >
      All templates
      <Icon name="mdi:arrow-right" class="h-4 w-4" />
    </a>
  </section>

  <section class="transition-page section-shell py-14 md:py-20">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight md:text-4xl">
          Or take just the screen you need.
        </h2>
        <p class="text-muted-foreground mt-3 md:text-lg">
          Every one runs live in your browser.
        </p>
      </div>
      <a
        href="/widgets/"
        class="text-primary hidden shrink-0 items-center gap-1 text-sm font-semibold sm:inline-flex"
        data-swup-preload
      >
        All {categoryCount} categories
        <Icon name="mdi:arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <WidgetsGrid only={FEATURED_CATEGORIES} />
    <a
      href="/widgets/"
      class="text-primary mt-5 inline-flex items-center gap-1 text-sm font-semibold sm:hidden"
    >
      All {categoryCount} categories
      <Icon name="mdi:arrow-right" class="h-4 w-4" />
    </a>
  </section>

  <Footer />
</BaseHtml>
