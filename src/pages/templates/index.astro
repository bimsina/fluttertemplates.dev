---
import BaseHtml from "@/components/BaseHtml.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const templates = await getCollection("templates");
---

<BaseHtml title="Templates">
  <section class="transition-page section-shell min-h-screen pt-28 pb-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
        App Templates
      </h1>
      <p class="text-muted-foreground mt-2">
        Full Flutter templates with runnable demos and source snippets.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        templates.map((template, index) => (
          <a
            href={`/templates/${template.id}/`}
            class="surface interactive-card group overflow-hidden"
            style={`--delay:${Math.min(index * 35, 260)}ms`}
            data-reveal
            data-swup-preload
          >
            {template.data.heroImage && (
              <Image
                class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                src={template.data.heroImage}
                alt={template.data.title}
              />
            )}
            <div class="p-4">
              <h2 class="group-hover:text-primary text-lg font-semibold tracking-tight">
                {template.data.title}
              </h2>
              <p class="text-muted-foreground mt-2 line-clamp-2 text-sm">
                {template.data.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
  <Footer />
</BaseHtml>
