---
import { Icon } from "astro-icon/components";
import { getWidgetStats } from "@/utils/get_widget_stats";
import HeroFloatingPreviews from "./HeroFloatingPreviews.astro";

const { widgetCount, categoryCount } = await getWidgetStats();
---

<section
  class="transition-page bg-background relative min-h-[620px] overflow-hidden pt-20 md:min-h-[760px] md:pt-0"
>
  <HeroFloatingPreviews />

  <div
    class="section-shell relative z-10 mx-auto flex max-w-3xl flex-col items-center px-4 pt-9 pb-20 text-center md:pt-40 md:pb-40"
  >
    <h1
      class="max-w-[13ch] text-[2.35rem] leading-[1.04] font-extrabold tracking-tight text-balance sm:max-w-none sm:text-5xl md:text-6xl lg:text-7xl"
      style="--delay: 40ms"
      data-reveal
    >
      Production Flutter UI
      <br />
      <span class="text-gradient">Ready to copy</span>
    </h1>

    <p
      class="text-foreground/70 mt-5 max-w-xl text-base leading-7 text-pretty md:text-lg"
      style="--delay: 150ms"
      data-reveal
    >
      Preview every screen live in your browser, view the Dart source, and drop
      it into your project.
    </p>

    <div
      class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center"
      style="--delay: 220ms"
      data-reveal
    >
      <a
        href="/widgets"
        class="interactive-button bg-primary text-primary-foreground inline-flex min-w-44 items-center justify-center gap-2 rounded-2xl px-5 py-3 text-sm font-semibold hover:opacity-95"
        data-swup-preload
      >
        Browse the library
        <Icon name="mdi:arrow-right" class="interactive-icon-shift h-4 w-4" />
      </a>
      <a
        href="/templates"
        class="interactive-button border-border bg-card/90 text-foreground hover:bg-muted inline-flex min-w-40 items-center justify-center gap-2 rounded-2xl border px-5 py-3 text-sm font-semibold backdrop-blur"
        data-swup-preload
      >
        <Icon name="mdi:view-dashboard-outline" class="h-4 w-4" />
        Full templates
      </a>
    </div>

    <p
      class="text-muted-foreground mt-7 text-sm"
      style="--delay: 300ms"
      data-reveal
    >
      {widgetCount}+ widgets · {categoryCount}+ categories · MIT
    </p>
  </div>
</section>
