---
import BaseHtml from "@/components/BaseHtml.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";

const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order,
);

const GROUPS = [
  { title: "Start here", ids: ["getting-started", "cli"] },
  { title: "Look and layout", ids: ["theming", "responsive"] },
  { title: "Auth", ids: ["supabase-auth", "firebase-auth", "go-router-auth"] },
  { title: "State", ids: ["riverpod-forms", "bloc-forms"] },
];
---

<BaseHtml
  searchable={false}
  title="Flutter guides"
  description="Practical Flutter guides: add a screen to your app, theme it, and wire it to real auth, routing, and state management."
>
  <section class="transition-page section-shell min-h-screen pt-28 pb-16">
    <header class="mb-9">
      <h1 class="text-3xl font-bold tracking-tight md:text-5xl">Guides</h1>
      <p class="text-muted-foreground mt-3 max-w-2xl md:text-lg">
        From copying your first screen to wiring it to a real backend.
      </p>
    </header>
    <div class="flex flex-col gap-10">
      {
        GROUPS.map((group) => (
          <section>
            <h2 class="text-xl font-semibold tracking-tight">{group.title}</h2>
            <ul class="mt-4 grid gap-4 md:grid-cols-2">
              {guides
                .filter((guide) => group.ids.includes(guide.id))
                .map((guide) => (
                  <li>
                    <a
                      href={`/guides/${guide.id}/`}
                      class="border-border bg-card interactive-card group block h-full rounded-2xl border p-5"
                    >
                      <h3 class="group-hover:text-primary font-semibold tracking-tight transition-colors">
                        {guide.data.title}
                      </h3>
                      <p class="text-muted-foreground mt-1.5 text-sm">
                        {guide.data.description}
                      </p>
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
  <Footer />
</BaseHtml>
