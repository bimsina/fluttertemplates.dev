---
import BaseHtml from "@/components/BaseHtml.astro";
import Footer from "@/components/Footer.astro";
import WidgetsGrid from "@/components/WidgetsGrid.astro";
import WidgetSearch, { type WidgetSearchItem } from "@/components/WidgetSearch";
import { getGroupedWidgets } from "@/utils/get_grouped_widgets";
import { getWidgetStats } from "@/utils/get_widget_stats";
import { getCollection } from "astro:content";

interface Group {
  title: string;
  path: string;
  items: {
    id: string;
    filePath?: string;
    data: { title: string; icon?: string };
  }[];
  indexFile: { id: string; data: { title: string; icon?: string } } | null;
  children?: Group[];
}

const groups = (await getGroupedWidgets()) as unknown as Group[];

const searchItems: WidgetSearchItem[] = [];
function walk(group: Group) {
  const cid = group.indexFile?.id ?? group.path;
  const ctitle = group.indexFile?.data.title ?? group.title;
  const cicon = group.indexFile?.data.icon;
  searchItems.push({ id: cid, title: ctitle, kind: "category", icon: cicon });
  (group.items ?? [])
    .filter((i) => !i.filePath?.endsWith("index.md"))
    .forEach((i) => {
      searchItems.push({
        id: i.id,
        title: i.data.title,
        category: ctitle,
        kind: "widget",
        icon: i.data.icon ?? cicon,
      });
    });
  (group.children ?? []).forEach(walk);
}
groups.forEach(walk);

for (const template of await getCollection("templates")) {
  searchItems.push({
    id: template.id,
    title: template.data.title,
    kind: "template",
    icon: "mdi:cellphone",
    keywords: (template.data.tags ?? []).join(" "),
  });
}

const { widgetCount, categoryCount } = await getWidgetStats();
---

<BaseHtml title="Widgets" image="/og/widgets.png" searchable={false}>
  <section class="transition-page section-shell min-h-screen pt-28 pb-16">
    <header class="mb-7" data-reveal>
      <h1 class="text-3xl font-bold tracking-tight md:text-5xl">
        Flutter widgets
      </h1>
      <p class="text-muted-foreground mt-3 max-w-2xl md:text-lg">
        {widgetCount} Flutter screens across {categoryCount} categories. Preview each
        one live, then copy the source. Free and MIT-licensed.
      </p>
    </header>

    <div class="relative z-40 mb-9 max-w-2xl" data-reveal style="--delay: 60ms">
      <WidgetSearch items={searchItems} count={widgetCount} client:load />
    </div>

    <WidgetsGrid />
  </section>
  <Footer />
</BaseHtml>
