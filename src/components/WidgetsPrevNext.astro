---
import { Icon } from "astro-icon/components";

interface PageLink {
  url: string;
  title: string;
}

interface Props {
  prev?: PageLink;
  next?: PageLink;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav
      class="border-border mt-8 flex flex-col items-stretch gap-4 border-t pt-8 sm:flex-row sm:items-center sm:justify-between sm:gap-0"
      aria-label="Widget navigation"
    >
      {prev ? (
        <a
          href={prev.url}
          class="group hover:bg-muted text-foreground flex max-w-[50%] items-center gap-2 rounded-md px-4 py-2 transition-colors"
        >
          <Icon
            name="mdi:chevron-left"
            class="text-muted-foreground group-hover:text-primary size-5 shrink-0"
          />
          <span class="flex min-w-0 flex-col items-start">
            <span class="text-muted-foreground text-xs tracking-wider uppercase">
              Previous
            </span>
            <span class="group-hover:text-primary truncate font-medium">
              {prev.title}
            </span>
          </span>
        </a>
      ) : (
        <div />
      )}
      {next ? (
        <a
          href={next.url}
          class="group hover:bg-muted text-foreground flex max-w-[50%] items-center gap-2 rounded-md px-4 py-2 transition-colors sm:flex-row-reverse sm:text-right"
        >
          <Icon
            name="mdi:chevron-right"
            class="text-muted-foreground group-hover:text-primary size-5 shrink-0"
          />
          <span class="flex min-w-0 flex-col items-start sm:items-end">
            <span class="text-muted-foreground text-xs tracking-wider uppercase">
              Next
            </span>
            <span class="group-hover:text-primary truncate font-medium">
              {next.title}
            </span>
          </span>
        </a>
      ) : (
        <div />
      )}
    </nav>
  )
}
