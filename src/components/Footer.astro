---
import { Icon } from "astro-icon/components";
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL, TWITTER_URL } from "@/consts";

const currentYear = new Date().getFullYear();
---

<footer class="section-shell py-10">
  <div class="surface p-6 md:p-8">
    <div
      class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <p class="text-lg font-bold tracking-tight">{SITE_TITLE}</p>
        <p class="text-muted-foreground mt-2 text-sm">
          Curated Flutter templates and widgets for production teams.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="interactive-button border-border hover:bg-muted rounded-xl border p-2"
          aria-label="GitHub"
        >
          <Icon name="mdi:github" class="h-5 w-5" />
        </a>
        <a
          href={TWITTER_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="interactive-button border-border hover:bg-muted rounded-xl border p-2"
          aria-label="Twitter"
        >
          <Icon name="mdi:twitter" class="h-5 w-5" />
        </a>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="interactive-button border-border hover:bg-muted rounded-xl border p-2"
          aria-label="LinkedIn"
        >
          <Icon name="mdi:linkedin" class="h-5 w-5" />
        </a>
      </div>
    </div>

    <div
      class="border-border text-muted-foreground mt-8 flex flex-col gap-2 border-t pt-5 text-xs md:flex-row md:items-center md:justify-between"
    >
      <p>© {currentYear} {SITE_TITLE}</p>
      <p>MIT Licensed • Built for fast iteration</p>
    </div>
  </div>
</footer>
