---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const widgets = (await getCollection("widgets"))
  .filter((cmp) => cmp.filePath?.endsWith("index.md") && !cmp.id.includes("/"))
  .sort((a, b) => a.data.order - b.data.order);
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    widgets.map((widget, index) => (
      <a
        href={`/widgets/${widget.id}/`}
        class="surface interactive-card group p-5"
        style={`--delay:${Math.min(index * 30, 240)}ms`}
        data-reveal
        data-swup-preload
      >
        <div class="bg-muted/70 text-muted-foreground group-hover:bg-muted group-hover:text-foreground mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl transition-colors">
          {widget.data.icon && <Icon name={widget.data.icon} class="size-5" />}
        </div>
        <h3 class="group-hover:text-foreground text-base font-semibold tracking-tight">
          {widget.data.title}
        </h3>
        <p class="text-muted-foreground mt-2 text-sm">
          Reusable Flutter patterns and UI building blocks.
        </p>
      </a>
    ))
  }
</div>
