---
import { Icon } from "astro-icon/components";

interface Props {
  slug: string;
  icon?: string;
  title?: string;
  count?: number;
  className?: string;
}

const { slug, icon, title, count, className } = Astro.props;
const bars = [42, 62, 48, 80, 60, 92, 78];
const shortTitle = title ?? slug.replaceAll("_", " ");
const known = [
  "admin",
  "ai",
  "animation",
  "auth",
  "calendar",
  "chat",
  "communication",
  "core",
  "crm",
  "dashboard",
  "ecommerce",
  "education",
  "events",
  "finance",
  "food",
  "forms",
  "gallery",
  "health",
  "info",
  "iot",
  "layouts",
  "maps",
  "marketplace",
  "media",
  "must_haves",
  "navigation",
  "notifications",
  "overlays",
  "pricing",
  "productivity",
  "profile",
  "saas",
  "search",
  "social",
  "states",
  "travel",
  "utilities",
];
---

<div
  class:list={["bg-background relative h-40 overflow-hidden p-3", className]}
>
  <div
    class="border-border/80 bg-card/55 relative h-full overflow-hidden rounded-xl border p-3 transition-transform duration-200 ease-out motion-safe:group-hover:-translate-y-0.5"
  >
    {
      slug === "admin" && (
        <div class="relative grid h-full grid-cols-[0.34fr_1fr] gap-2.5">
          <div class="bg-muted flex flex-col gap-1.5 rounded-lg p-2">
            {["Users", "Roles", "Logs"].map((label, i) => (
              <span
                class:list={[
                  "rounded-lg px-2 py-1 text-[0.56rem] font-semibold",
                  i === 0
                    ? "bg-primary text-primary-foreground"
                    : "text-muted-foreground",
                ]}
              >
                {label}
              </span>
            ))}
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="text-[0.66rem] font-semibold">Team access</span>
              <Icon
                name="mdi:shield-check-outline"
                class="text-primary size-4"
              />
            </div>
            {[72, 58, 66].map((w, i) => (
              <div class="bg-background flex items-center gap-2 rounded-md px-2 py-1.5 transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5">
                <span class="bg-muted size-5 rounded-full" />
                <span class="bg-muted h-1.5 rounded" style={`width:${w}%`} />
                {i === 0 && <span class="bg-primary size-1.5 rounded-full" />}
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      slug === "ai" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          <div class="bg-background flex max-w-[82%] items-start gap-2 rounded-2xl px-3 py-2 text-[0.66rem]">
            <Icon name="mdi:robot-outline" class="text-primary mt-0.5 size-4" />
            Generate a calm empty state
          </div>
          <div class="bg-primary text-primary-foreground ml-auto rounded-2xl rounded-br-md px-3 py-2 text-[0.66rem] transition-transform duration-200 ease-out motion-safe:group-hover:-translate-y-0.5">
            Done. 3 variants.
          </div>
          <div class="bg-muted flex items-center gap-2 rounded-full px-3 py-1.5">
            <span class="bg-primary h-1.5 w-8 rounded-full" />
            <span class="bg-muted-foreground/20 h-1.5 flex-1 rounded-full" />
            <Icon
              name="mdi:microphone-outline"
              class="text-muted-foreground size-3.5"
            />
          </div>
        </div>
      )
    }

    {
      slug === "auth" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          <div class="flex items-center justify-between">
            <span class="text-[0.68rem] font-semibold">Sign in</span>
            <Icon name="mdi:fingerprint" class="text-primary size-5" />
          </div>
          <div class="bg-muted h-8 rounded-lg" />
          <div class="border-primary/35 bg-background h-8 rounded-lg border" />
          <div class="bg-primary text-primary-foreground rounded-lg py-2 text-center text-[0.64rem] font-semibold transition-transform duration-200 ease-out motion-safe:group-hover:-translate-y-0.5">
            Continue
          </div>
        </div>
      )
    }

    {
      slug === "core" && (
        <div class="relative flex h-full flex-col justify-center gap-3">
          <div class="flex items-center gap-2.5">
            <span class="bg-primary text-primary-foreground rounded-lg px-3 py-1.5 text-[0.68rem] font-semibold">
              Button
            </span>
            <span class="bg-primary flex h-5 w-9 items-center rounded-full px-0.5">
              <span class="bg-primary-foreground h-4 w-4 rounded-full transition-transform duration-300 ease-out motion-safe:group-hover:translate-x-4" />
            </span>
            <span class="bg-primary text-primary-foreground flex h-5 w-5 items-center justify-center rounded">
              <Icon name="mdi:check" class="size-3.5" />
            </span>
          </div>
          <div class="bg-muted relative h-1.5 w-full rounded-full">
            <div class="bg-primary h-1.5 w-2/5 rounded-full transition-[width] duration-500 ease-out motion-safe:group-hover:w-3/5" />
            <span class="border-card bg-primary absolute top-1/2 left-2/5 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 transition-[left] duration-500 ease-out motion-safe:group-hover:left-3/5" />
          </div>
        </div>
      )
    }

    {
      slug === "chat" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          <div class="bg-muted text-foreground max-w-[78%] rounded-2xl rounded-bl-md px-3 py-2 text-[0.72rem]">
            Is the design system ready?
          </div>
          <div class="bg-primary text-primary-foreground ml-auto max-w-[78%] rounded-2xl rounded-br-md px-3 py-2 text-[0.72rem]">
            Shipping it now
          </div>
          <div class="bg-muted text-muted-foreground mt-1 flex items-center justify-between rounded-full px-3 py-1.5 font-mono text-[0.66rem]">
            Message...
            <Icon
              name="mdi:send"
              class="text-muted-foreground motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
            />
          </div>
        </div>
      )
    }

    {
      slug === "communication" && (
        <div class="relative flex h-full flex-col items-center justify-center gap-2.5">
          <span class="bg-muted h-12 w-12 rounded-full" />
          <div class="bg-muted/80 h-1.5 w-16 rounded-full" />
          <div class="flex gap-2.5">
            <span class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full transition duration-300 motion-safe:group-hover:brightness-110">
              <Icon name="mdi:phone" class="size-4" />
            </span>
            <span class="bg-muted text-muted-foreground flex h-8 w-8 items-center justify-center rounded-full">
              <Icon name="mdi:microphone-off" class="size-4" />
            </span>
            <span class="bg-muted text-muted-foreground flex h-8 w-8 items-center justify-center rounded-full">
              <Icon name="mdi:video-outline" class="size-4" />
            </span>
          </div>
        </div>
      )
    }

    {
      slug === "animation" && (
        <div class="relative flex h-full items-center justify-center">
          <span class="ft-ripple border-primary/25 absolute inset-0 m-auto h-10 w-10 rounded-full border-2" />
          <span
            class="ft-ripple border-primary/25 absolute inset-0 m-auto h-10 w-10 rounded-full border-2"
            style="animation-delay:0.8s"
          />
          <span
            class="ft-ripple border-primary/25 absolute inset-0 m-auto h-10 w-10 rounded-full border-2"
            style="animation-delay:1.6s"
          />
          <span class="ft-core bg-primary/90 text-primary-foreground relative z-10 flex h-11 w-11 items-center justify-center rounded-full">
            <Icon name="mdi:play" class="size-5" />
          </span>
        </div>
      )
    }

    {
      slug === "layouts" && (
        <div class="relative grid h-full grid-cols-3 grid-rows-2 gap-2">
          <span class="bg-secondary row-span-2 rounded-lg" />
          <span class="bg-muted rounded-lg" />
          <span class="bg-muted/80 rounded-lg" />
          <span class="bg-primary/10 motion-safe:group-hover:bg-primary/15 col-span-2 rounded-lg transition-colors duration-300" />
        </div>
      )
    }

    {
      slug === "forms" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          <div class="bg-muted text-muted-foreground rounded-lg px-2.5 py-2 font-mono text-[0.64rem]">
            Full name
          </div>
          <div class="border-primary/40 bg-background ring-primary/10 rounded-lg border px-2.5 py-2 font-mono text-[0.64rem] ring-2">
            jane@studio.dev
          </div>
          <div class="bg-primary text-primary-foreground rounded-lg py-2 text-center text-[0.66rem] font-semibold transition duration-300 motion-safe:group-hover:brightness-110">
            Create account
          </div>
        </div>
      )
    }

    {
      slug === "overlays" && (
        <div class="bg-muted relative h-full overflow-hidden rounded-lg">
          <div class="bg-card absolute inset-x-2 bottom-0 rounded-t-lg p-3 transition-transform duration-300 ease-out motion-safe:translate-y-2 motion-safe:group-hover:translate-y-0">
            <div class="bg-muted-foreground/30 mx-auto h-1 w-8 rounded-full" />
            <div class="bg-muted mt-2.5 h-2 w-2/3 rounded" />
            <div class="bg-muted mt-1.5 h-1.5 w-1/2 rounded opacity-70" />
            <div class="bg-primary text-primary-foreground mt-2.5 rounded-lg py-1.5 text-center text-[0.64rem] font-semibold">
              Confirm
            </div>
          </div>
        </div>
      )
    }

    {
      slug === "states" && (
        <div class="relative flex h-full flex-col items-center justify-center gap-2 text-center">
          <div class="bg-muted text-muted-foreground motion-safe:group-hover:bg-primary/10 motion-safe:group-hover:text-primary flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-300">
            <Icon name="mdi:inbox-outline" class="size-5" />
          </div>
          <div class="bg-muted h-2 w-28 rounded" />
          <div class="bg-muted h-1.5 w-20 rounded opacity-70" />
        </div>
      )
    }

    {
      slug === "ecommerce" && (
        <div class="relative grid h-full grid-cols-2 content-center gap-2.5">
          {[
            ["$48", "bg-muted"],
            ["$92", "bg-secondary"],
          ].map((item) => (
            <div class="bg-background overflow-hidden rounded-lg">
              <div
                class={`h-12 transition-transform duration-500 ease-out motion-safe:group-hover:scale-105 ${item[1]}`}
              />
              <div class="p-2">
                <div class="bg-muted-foreground/15 h-1.5 w-3/4 rounded" />
                <div class="mt-1.5 flex items-center justify-between">
                  <span class="font-mono text-[0.62rem] font-semibold">
                    {item[0]}
                  </span>
                  <span class="bg-primary/20 h-3.5 w-3.5 rounded" />
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      slug === "social" && (
        <div class="bg-background relative flex h-full flex-col justify-center rounded-lg p-3">
          <div class="flex items-center gap-2">
            <span class="bg-muted h-6 w-6 rounded-full" />
            <div class="bg-muted-foreground/15 h-1.5 w-16 rounded" />
          </div>
          <div class="bg-muted mt-2 h-12 rounded-lg" />
          <div class="text-muted-foreground mt-2 flex gap-3">
            <Icon
              name="mdi:heart-outline"
              class="motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
            />
            <Icon name="mdi:comment-outline" class="size-3.5" />
            <Icon name="mdi:share-outline" class="size-3.5" />
          </div>
        </div>
      )
    }

    {
      slug === "search" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          <div class="bg-muted text-muted-foreground flex items-center gap-2 rounded-full px-3 py-2 font-mono text-[0.66rem]">
            <Icon
              name="mdi:magnify"
              class="motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
            />
            Search widgets...
          </div>
          {[70, 52].map((w) => (
            <div class="flex items-center gap-2.5 px-1">
              <Icon name="mdi:history" class="text-muted-foreground size-3.5" />
              <div class="bg-muted h-1.5 rounded" style={`width:${w}%`} />
            </div>
          ))}
        </div>
      )
    }

    {
      slug === "finance" && (
        <div class="relative flex h-full flex-col justify-center">
          <div class="text-muted-foreground text-[0.58rem] font-semibold uppercase">
            Total balance
          </div>
          <div class="text-xl font-bold tabular-nums">$12,840</div>
          <div class="mt-3 flex h-10 items-end gap-1.5">
            {bars.map((h, i) => (
              <span
                class={`flex-1 rounded-t transition-colors duration-300 ease-out ${i === 3 ? "bg-primary/50" : "bg-muted motion-safe:group-hover:bg-primary/20"}`}
                style={`height:${h}%;transition-delay:${i * 40}ms`}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      slug === "food" && (
        <div class="relative flex h-full flex-col justify-center gap-3">
          {[
            { n: "Saffron Kitchen", s: "4.8 / 25 min / $$" },
            { n: "Green Bowl", s: "4.6 / 18 min / $" },
          ].map((r, i) => (
            <div class="flex items-center gap-2.5">
              <span
                class:list={[
                  "h-10 w-10 flex-none rounded-lg transition duration-300 motion-safe:group-hover:brightness-105",
                  i === 0 ? "bg-muted" : "bg-secondary",
                ]}
              />
              <div>
                <div class="text-[0.78rem] font-semibold">{r.n}</div>
                <div class="text-muted-foreground mt-0.5 font-mono text-[0.6rem]">
                  {r.s}
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      slug === "health" && (
        <div class="relative flex h-full items-center justify-center gap-4">
          <div
            class="relative h-20 w-20 rounded-full"
            style="background:conic-gradient(var(--primary) 72%, var(--muted) 0)"
          >
            <div class="bg-card absolute inset-[7px] flex items-center justify-center rounded-full text-[0.72rem] font-bold">
              72%
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="bg-muted text-foreground rounded-md px-2 py-1 text-[0.6rem] font-semibold">
              8,240 steps
            </span>
            <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-[0.6rem] font-semibold">
              62 bpm
            </span>
          </div>
        </div>
      )
    }

    {
      slug === "education" && (
        <div class="relative flex h-full flex-col justify-center gap-3">
          <div class="flex items-center gap-2.5">
            <span class="bg-muted text-muted-foreground motion-safe:group-hover:bg-primary/10 motion-safe:group-hover:text-primary flex h-9 w-9 flex-none items-center justify-center rounded-lg transition-colors duration-300">
              <Icon name="mdi:play" class="size-4" />
            </span>
            <div class="flex-1">
              <div class="bg-muted h-2 w-2/3 rounded" />
              <div class="bg-muted mt-1.5 h-1.5 w-full overflow-hidden rounded-full">
                <div class="bg-primary h-1.5 w-3/5 rounded-full transition-[width] duration-500 ease-out motion-safe:group-hover:w-[85%]" />
              </div>
            </div>
            <span class="text-muted-foreground font-mono text-[0.6rem]">
              3/5
            </span>
          </div>
          <div class="flex gap-2">
            <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-[0.58rem] font-semibold">
              Quiz
            </span>
            <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-[0.58rem] font-semibold">
              Flashcards
            </span>
          </div>
        </div>
      )
    }

    {
      slug === "events" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          <div class="bg-background rounded-lg p-3">
            <div class="flex items-center justify-between">
              <span class="text-[0.68rem] font-semibold">Design Conf</span>
              <span class="bg-primary/10 text-primary rounded-full px-2 py-0.5 font-mono text-[0.56rem] font-semibold">
                JUL 12
              </span>
            </div>
            <div class="bg-muted mt-2 h-2 w-2/3 rounded" />
            <div class="mt-3 flex items-center gap-2">
              <span class="bg-muted size-5 rounded-full" />
              <span class="bg-muted size-5 rounded-full" />
              <span class="bg-primary text-primary-foreground rounded-full px-2 py-0.5 text-[0.56rem] font-semibold">
                Ticket
              </span>
            </div>
          </div>
        </div>
      )
    }

    {
      slug === "travel" && (
        <div class="relative flex h-full flex-col justify-center">
          <div class="relative overflow-hidden rounded-lg">
            <div class="bg-muted h-24 transition-transform duration-500 ease-out motion-safe:group-hover:scale-105" />
            <span class="bg-card/90 text-foreground absolute top-2 left-2 rounded-full px-2 py-0.5 text-[0.58rem] font-semibold">
              4.9
            </span>
            <span class="text-foreground absolute bottom-2 left-2 text-[0.72rem] font-bold">
              Kyoto, Japan
            </span>
            <span class="bg-card/90 text-foreground absolute right-2 bottom-2 rounded-full px-2 py-0.5 font-mono text-[0.58rem] font-semibold">
              $1,240
            </span>
          </div>
        </div>
      )
    }

    {
      slug === "media" && (
        <div class="bg-background relative flex h-full items-center gap-2.5 rounded-lg p-3">
          <span class="bg-muted h-12 w-12 flex-none rounded-lg" />
          <div class="flex-1">
            <div class="bg-muted h-2 w-2/3 rounded" />
            <div class="bg-muted mt-1 h-1.5 w-1/3 rounded opacity-70" />
            <div class="bg-muted mt-2 h-1 w-full overflow-hidden rounded">
              <div class="bg-primary h-1 w-1/2 rounded transition-[width] duration-500 ease-out motion-safe:group-hover:w-4/5" />
            </div>
          </div>
          <span class="bg-primary text-primary-foreground flex h-7 w-7 flex-none items-center justify-center rounded-full transition duration-300 motion-safe:group-hover:brightness-110">
            <Icon name="mdi:play" class="size-3.5" />
          </span>
        </div>
      )
    }

    {
      slug === "dashboard" && (
        <div class="relative grid h-full grid-cols-2 content-center gap-2">
          <div class="bg-background rounded-lg p-2.5">
            <div class="text-muted-foreground text-[0.56rem] font-semibold uppercase">
              MRR
            </div>
            <div class="mt-0.5 text-base font-bold tabular-nums">$8.4k</div>
          </div>
          <div class="bg-background rounded-lg p-2.5">
            <div class="text-muted-foreground text-[0.56rem] font-semibold uppercase">
              Active
            </div>
            <div class="mt-0.5 text-base font-bold tabular-nums">1,204</div>
          </div>
          <div class="col-span-2 flex h-8 items-end gap-1.5">
            {bars.map((h, i) => (
              <span
                class={`flex-1 rounded-t transition-colors duration-300 ease-out ${i === 3 ? "bg-primary/50" : "bg-muted motion-safe:group-hover:bg-primary/20"}`}
                style={`height:${h}%;transition-delay:${i * 40}ms`}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      slug === "crm" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          {["Lead", "Qualified", "Won"].map((stage, i) => (
            <div class="bg-background flex items-center gap-2 rounded-lg p-2">
              <span
                class:list={[
                  "h-7 w-1 rounded-full",
                  i === 1 ? "bg-primary" : "bg-muted",
                ]}
              />
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <span class="text-[0.62rem] font-semibold">{stage}</span>
                  <span class="text-muted-foreground font-mono text-[0.56rem]">
                    {i + 2}
                  </span>
                </div>
                <div class="bg-muted mt-1 h-1.5 w-2/3 rounded" />
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      slug === "gallery" && (
        <div class="relative grid h-full grid-cols-3 grid-rows-2 gap-1.5">
          {[
            "bg-muted",
            "bg-secondary",
            "bg-muted/80",
            "bg-foreground/6",
            "bg-primary/10",
            "bg-secondary/80",
          ].map((tone, i) => (
            <span
              class:list={[
                "rounded-md transition-opacity duration-300 ease-out motion-safe:group-hover:opacity-100",
                tone,
              ]}
              style={`transition-delay:${i * 30}ms`}
            />
          ))}
        </div>
      )
    }

    {
      slug === "calendar" && (
        <div class="bg-background relative flex h-full flex-col justify-center rounded-lg p-3">
          <div class="mb-2 flex items-baseline justify-between">
            <span class="text-[0.7rem] font-semibold">July</span>
            <span class="text-muted-foreground font-mono text-[0.58rem]">
              2026
            </span>
          </div>
          <div class="grid grid-cols-7 justify-items-center gap-1.5">
            {Array.from({ length: 35 }).map((_, i) => (
              <span
                class={`h-2.5 w-2.5 rounded-[3px] transition-colors duration-300 ${i === 16 ? "bg-primary/60" : "bg-muted"}`}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      slug === "notifications" && (
        <div class="relative flex h-full flex-col justify-center gap-2">
          {[true, false, false].map((unread) => (
            <div class="bg-background flex items-center gap-2.5 rounded-lg px-2.5 py-2">
              <span
                class={`bg-muted text-muted-foreground flex h-7 w-7 flex-none items-center justify-center rounded-lg transition-colors duration-300 ${unread ? "motion-safe:group-hover:bg-primary/10 motion-safe:group-hover:text-primary" : ""}`}
              >
                <Icon name="mdi:bell-outline" class="size-3.5" />
              </span>
              <div class="flex-1">
                <div class="bg-muted h-1.5 w-3/4 rounded" />
                <div class="bg-muted mt-1 h-1.5 w-1/2 rounded opacity-70" />
              </div>
              {unread && (
                <span class="bg-primary h-2 w-2 flex-none rounded-full" />
              )}
            </div>
          ))}
        </div>
      )
    }

