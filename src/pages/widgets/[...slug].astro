---
import BaseHtml from "@/components/BaseHtml.astro";
import CopyPromptButton from "@/components/CopyPromptButton";
import TemplateWorkbench, { type View } from "@/components/TemplateWorkbench";
import WidgetArt from "@/components/WidgetArt.astro";
import WidgetsSidebar from "@/components/WidgetsSidebar";
import WidgetDetails from "@/components/WidgetDetails.astro";
import widgetMeta from "@/generated/widget_meta.json";
import { addPrompt, GITHUB_URL } from "@/consts";
import { type CollectionEntry, getCollection, render } from "astro:content";
import fs from "fs/promises";
import { getGroupedWidgets } from "@/utils/get_grouped_widgets";
import { getPrevNext } from "@/utils/get_widget_page_sequence";
import { serializeWidgetGroupsForSidebar } from "@/utils/serialize_widget_groups";
import WidgetsPrevNext from "@/components/WidgetsPrevNext.astro";
import Footer from "@/components/Footer.astro";

export async function getStaticPaths() {
  const widgets = await getCollection("widgets");

  return widgets.map((widget) => ({
    params: { slug: widget.id },
    props: widget,
  }));
}
type Props = CollectionEntry<"widgets">;

const widget = Astro.props;

const isGroup = widget.filePath?.endsWith("index.md");

const widgets = await getCollection("widgets");
const children = isGroup
  ? widgets.filter(
      (c) =>
        c.id.startsWith(widget.id) &&
        c.id !== widget.id &&
        (c.data.path ?? "").trim().length > 0,
    )
  : [];

const code = await Promise.all(
  widget.data.code_files.map(async (file: string) => {
    const filePath = "flutter_apps/" + widget.data.app + "/lib/" + file;
    const fileContent = await fs.readFile(filePath, "utf8");
    return {
      file,
      content: fileContent,
    };
  }),
);

const initialView: View =
  widget.data.previewSize === "mobile"
    ? "phone"
    : widget.data.previewSize;
const sourceUrl = `${GITHUB_URL}/blob/master/flutter_apps/${widget.data.app}/lib/${widget.data.code_files[0]}`;

const groupedWidgets = await getGroupedWidgets();
const sidebarGroups = serializeWidgetGroupsForSidebar(groupedWidgets);
const { prev, next } = await getPrevNext(widget.id);

const categorySlug = widget.id.split("/")[0];
const categoryEntry = widgets.find(
  (w) => w.id === categorySlug && w.filePath?.endsWith("index.md"),
);
const categoryTitle = categoryEntry?.data.title ?? categorySlug;

const pageTitle = isGroup
  ? `${widget.data.title} Flutter widgets`
  : `Flutter ${widget.data.title}`;

const pageDescription =
  widget.data.description ||
  (isGroup
    ? `Browse ${widget.data.title} Flutter UI components with live previews and copy-paste source. Free and MIT-licensed.`
    : `Live preview and Dart source for the Flutter ${widget.data.title} widget. Copy it straight into your app — free and MIT-licensed.`);

const meta = (widgetMeta as Record<string, (typeof widgetMeta)[keyof typeof widgetMeta]>)[widget.id];
const { Content } = await render(widget);
const hasNotes = (widget.body ?? "").trim().length > 0;

const siteBase = (Astro.site?.href ?? "https://fluttertemplates.dev/").replace(
  /\/$/,
  "",
);
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteBase + "/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Widgets",
      item: `${siteBase}/widgets/`,
    },
    ...(isGroup
      ? [
          {
            "@type": "ListItem",
            position: 3,
            name: widget.data.title,
            item: `${siteBase}/widgets/${widget.id}/`,
          },
        ]
      : [
          {
            "@type": "ListItem",
            position: 3,
            name: categoryTitle,
            item: `${siteBase}/widgets/${categorySlug}/`,
          },
          {
            "@type": "ListItem",
            position: 4,
            name: widget.data.title,
            item: `${siteBase}/widgets/${widget.id}/`,
          },
        ]),
  ],
};
const sourceCode = !isGroup && {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: `Flutter ${widget.data.title}`,
  description: pageDescription,
  url: `${siteBase}/widgets/${widget.id}/`,
  codeRepository: GITHUB_URL,
  programmingLanguage: "Dart",
  runtimePlatform: "Flutter",
  license: "https://opensource.org/licenses/MIT",
};
---

<BaseHtml
  searchTitle={`${widget.data.title} · ${isGroup ? "Category" : "Widget"}`}
  title={pageTitle}
  description={pageDescription}
  image={`/og/widgets/${widget.id}.png`}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumb)}
  />
  {
    sourceCode && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(sourceCode)}
      />
    )
  }

  <div class="section-shell pt-24 pb-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:gap-10">
      <WidgetsSidebar
        groups={sidebarGroups}
        currentPath={widget.id}
        client:only="react"
      />
      <div id="widgets-content" class="transition-page min-w-0 flex-1">
        <header class="mb-8">
          <nav
            class="text-muted-foreground mb-3 flex flex-wrap items-center gap-1.5 text-xs"
            aria-label="Breadcrumb"
          >
            <a href="/widgets/" class="hover:text-foreground transition-colors">
              Widgets
            </a>
            {
              !isGroup && (
                <>
                  <span aria-hidden="true">/</span>
                  <a
                    href={`/widgets/${categorySlug}/`}
                    class="hover:text-foreground transition-colors"
                  >
                    {categoryTitle}
                  </a>
                </>
              )
            }
            <span aria-hidden="true">/</span>
            <span class="text-foreground">{widget.data.title}</span>
          </nav>
          <h1 class="text-2xl font-bold tracking-tight md:text-3xl">
            {widget.data.title}
          </h1>
          {
            isGroup && (
              <p class="text-muted-foreground mt-2 max-w-2xl text-sm md:text-base">
                {pageDescription}
              </p>
            )
          }
        </header>

        {
          isGroup ? (
            <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {children.map((child) => (
                <li>
                  <a
                    href={`/widgets/${child.id}/`}
                    class="border-border bg-card interactive-card group block h-full overflow-hidden rounded-2xl border"
                    data-swup-preload
                  >
                    <WidgetArt id={child.id} icon={widget.data.icon} />
                    <div class="p-4">
                      <h2 class="group-hover:text-primary font-semibold tracking-tight transition-colors">
                        {child.data.title}
                      </h2>
                      <p class="text-muted-foreground mt-1 line-clamp-2 text-sm">
                        {child.data.description}
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <>
              <TemplateWorkbench
                client:load
                title={widget.data.title}
                path={widget.data.path}
                registryUrl={`/r/${widget.id}.json`}
                files={widget.data.code_files}
                initialView={initialView}
                showDesktop
              />
              <div class="mt-8 max-w-2xl">
                <p class="text-muted-foreground md:text-lg">{pageDescription}</p>
                <div class="mt-5 flex flex-wrap gap-3" data-pagefind-ignore>
                  <a
                    href={sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="interactive-button bg-primary text-primary-foreground inline-flex h-11 items-center justify-center rounded-xl px-5 text-sm font-semibold hover:opacity-95"
                  >
                    Get the source
                  </a>
                  <CopyPromptButton
                    client:load
                    prompt={addPrompt(widget.data.title, widget.id)}
                  />
                </div>
              </div>
              {/* The viewer loads source on demand, so crawlers get it here. */}
              <div hidden data-pagefind-ignore="all">
                {code.map((file) => (
                  <pre><code>{file.content}</code></pre>
                ))}
              </div>
            </>
          )
        }
        {
          meta && (
            <div data-template-docs>
              <WidgetDetails
                id={widget.id}
                title={widget.data.title}
                dependencies={meta.dependencies}
                related={meta.related}
              >
                {hasNotes && <Content />}
              </WidgetDetails>
            </div>
          )
        }
        <WidgetsPrevNext prev={prev} next={next} />
      </div>
    </div>
  </div>

  <Footer />
</BaseHtml>
