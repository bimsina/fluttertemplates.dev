---
import type { CollectionEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import BaseHtml from "@/components/BaseHtml.astro";
import FlutterAppIframe from "@/components/FlutterAppIframe";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { YouTube } from "astro-embed";

type Props = CollectionEntry<"templates">["data"] & {
  ogImage?: string;
};

const {
  title,
  description,
  heroImage,
  demoUrl,
  githubUrl,
  appImages,
  youtubeVideoId,
  ogImage,
} = Astro.props;
---

<BaseHtml
  title={title}
  description={description}
  image={ogImage ?? heroImage?.src}
>
  <section class="transition-page section-shell pt-28 pb-6">
    <div class="grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface p-6 md:p-8">
        <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
        <p class="text-muted-foreground mt-3 text-sm md:text-base">
          {description}
        </p>

        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="interactive-button bg-primary text-primary-foreground mt-4 inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold hover:opacity-90"
            >
              <Icon name="mdi:code-tags" class="h-4 w-4" />
              View Source
            </a>
          )
        }

        {
          appImages && (
            <>
              <h2 class="mt-8 text-xl font-semibold tracking-tight">
                Screenshots
              </h2>
              <div class="mt-3 grid grid-cols-2 gap-3">
                {appImages.map((image) => (
                  <Image
                    src={image}
                    alt={title}
                    class="border-border h-full w-auto rounded-xl border object-cover transition-transform duration-300 hover:scale-[1.02]"
                    width={320}
                    height={180}
                    loading="lazy"
                  />
                ))}
              </div>
            </>
          )
        }

        {
          youtubeVideoId && (
            <>
              <h2 class="mt-8 text-xl font-semibold tracking-tight">Demo</h2>
              <div class="border-border mt-3 overflow-hidden rounded-xl border">
                <YouTube id={youtubeVideoId} class="w-full" />
              </div>
            </>
          )
        }

        <article
          class="prose prose-headings:font-semibold prose-headings:tracking-tight dark:prose-invert mt-8 max-w-none"
        >
          <slot />
        </article>
      </div>

      <div class="surface p-4 md:p-6">
        <div class="mx-auto w-[280px] md:w-[320px]">
          <FlutterAppIframe
            path={demoUrl}
            client:only="react"
            skipUrlFormatting
            className="bg-card border-border h-[600px] w-full overflow-clip rounded-4xl border md:h-[680px]"
            enableShowFullScreenButton
          />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseHtml>
