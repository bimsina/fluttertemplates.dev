---
import type { WidgetGroupType } from "@/types";
import WidgetsNavGroup from "./WidgetsNavSidebar.astro";
import { Icon } from "astro-icon/components";

interface Props {
  groups: WidgetGroupType[];
  currentPath: string;
}

const { groups, currentPath } = Astro.props;

function groupContainsPath(group: WidgetGroupType, path: string): boolean {
  const id = group.indexFile?.id ?? group.path;
  if (path === id || path.startsWith(id + "/")) return true;
  return !!group.children?.some((c) => groupContainsPath(c, path));
}
---

<aside
  id="widgets-sidebar"
  class="w-64 shrink-0 border-r flex flex-col h-[calc(100vh-4rem)]"
  data-current-path={currentPath}
>
  <div class="sticky top-0 z-10 shrink-0 border-b p-3">
    <div class="relative">
      <Icon
        name="mdi:magnify"
        class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground pointer-events-none"
      />
      <input
        type="search"
        id="widgets-sidebar-search"
        placeholder="Search widgets..."
        class="w-full pl-9 pr-3 py-2 text-sm rounded-md border border-input bg-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        autocomplete="off"
      />
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto overscroll-contain py-2" id="widgets-nav">
    {
      groups.map((group) => (
        <WidgetsNavGroup
          group={group}
          currentPath={currentPath}
          isNested={false}
          expandOnLoad={groupContainsPath(group, currentPath)}
        />
      ))
    }
  </nav>
</aside>

<script>
  const searchInput = document.getElementById("widgets-sidebar-search");
  const nav = document.getElementById("widgets-nav");

  function filterBySearch(query: string) {
    const q = (query ?? "").trim().toLowerCase();
    const allGroups = Array.from(
      nav?.querySelectorAll("[data-group-id]") ?? [],
    );
    const allItems = nav?.querySelectorAll("[data-item-id]") ?? [];

    if (q === "") {
      allGroups.forEach((el) => el.classList.remove("sidebar-search-hidden"));
      allItems.forEach((el) => el.classList.remove("sidebar-search-hidden"));
      return;
    }

    allItems.forEach((itemEl) => {
      const text = (itemEl.getAttribute("data-item-title") ?? "").toLowerCase();
      itemEl.classList.toggle("sidebar-search-hidden", !text.includes(q));
    });

    allGroups
      .slice()
      .reverse()
      .forEach((groupEl) => {
        const title = (
          groupEl.getAttribute("data-group-title") ?? ""
        ).toLowerCase();
        const childItems = groupEl.querySelectorAll("[data-item-id]");
        const childGroups = groupEl.querySelectorAll(":scope [data-group-id]");
        const descendantGroups = Array.from(childGroups).filter(
          (g) => g !== groupEl,
        );

        const anyItemVisible = Array.from(childItems).some(
          (el) => !el.classList.contains("sidebar-search-hidden"),
        );
        const anyChildGroupVisible = descendantGroups.some(
          (g) => !g.classList.contains("sidebar-search-hidden"),
        );

        const visible =
          title.includes(q) || anyItemVisible || anyChildGroupVisible;
        groupEl.classList.toggle("sidebar-search-hidden", !visible);
      });
  }

  function scrollToActive() {
    const activeLink = nav?.querySelector("a.sidebar-active");
    if (activeLink) {
      activeLink.scrollIntoView({ block: "nearest", behavior: "instant" });
    }
  }

  searchInput?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement | null;
    filterBySearch(target?.value ?? "");
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scrollToActive);
  } else {
    scrollToActive();
  }
</script>

<style>
  .sidebar-search-hidden {
    display: none !important;
  }

  .sidebar-active {
    background-color: hsl(var(--color-primary) / 0.15);
    color: hsl(var(--color-primary));
    font-weight: 500;
  }

  .sidebar-group-active .group-header-link {
    color: hsl(var(--color-primary));
    font-weight: 600;
  }
</style>
