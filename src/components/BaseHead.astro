---
import { SEO } from "astro-seo";
import "../styles/global.css";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const cleanPathname = Astro.url.pathname
  .replace(/\.html$/, "")
  .replace(/\/$/, "");
const canonicalURL = cleanPathname
  ? new URL(cleanPathname, Astro.site!).href
  : Astro.site!.href.replace(/\/$/, "");
const { title, description, image = "/og.png" } = Astro.props;
const imageURL = new URL(image, Astro.url).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
<link
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<SEO
  title={title}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      title,
      type: "website",
      image: imageURL,
      url: Astro.url.toString(),
    },
    optional: {
      description,
      siteName: SITE_TITLE,
      locale: "en_US",
    },
    image: {
      url: imageURL,
      alt: title,
      width: 1200,
      height: 630,
    },
  }}
  twitter={{
    card: "summary_large_image",
    site: SITE_TITLE,
    creator: SITE_TITLE,
    title,
    description,
    image: imageURL,
  }}
  extend={{
    meta: [
      {
        name: "robots",
        content: "index, follow",
      },
      {
        name: "author",
        content: "Flutter Templates",
      },
      {
        name: "keywords",
        content:
          "Flutter, Flutter templates, Flutter UI, Flutter snippets, open source, production ready, mobile app development, Flutter components",
      },
      {
        name: "twitter:image:alt",
        content: title,
      },
      {
        property: "og:image:alt",
        content: title,
      },
      {
        property: "og:image:width",
        content: "1200",
      },
      {
        property: "og:image:height",
        content: "630",
      },
    ],
  }}
/>

<script is:inline>
  const THEME_KEY = "theme";
  const THEME_DARK = "dark";
  const THEME_LIGHT = "light";
  const THEME_SYSTEM = "system";

  const getSystemPreference = () =>
    window.matchMedia("(prefers-color-scheme: dark)").matches
      ? THEME_DARK
      : THEME_LIGHT;

  const getStoredTheme = () => localStorage.getItem(THEME_KEY) || THEME_SYSTEM;

  const resolveTheme = (theme) =>
    theme === THEME_SYSTEM ? getSystemPreference() : theme;

  const applyTheme = (themeChoice) => {
    const theme = resolveTheme(themeChoice);
    document.documentElement.classList.toggle("dark", theme === THEME_DARK);
    document.documentElement.setAttribute("data-theme", themeChoice);
  };

  const initializeTheme = () => {
    applyTheme(getStoredTheme());
  };

  const setupThemeListener = () => {
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
    const handleChange = () => {
      if ((localStorage.getItem(THEME_KEY) || THEME_SYSTEM) === THEME_SYSTEM) {
        applyTheme(THEME_SYSTEM);
      }
    };

    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener("change", handleChange);
    } else {
      mediaQuery.addListener(handleChange);
    }
  };

  if (typeof document !== "undefined") {
    initializeTheme();
    setupThemeListener();
  }
</script>
