---
import BaseHtml from "@/components/BaseHtml.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { GITHUB_URL } from "@/consts";

// Templates that run in the library come first, the older example last.
const templates = (await getCollection("templates")).sort(
  (a, b) => Number(!a.data.code_dir) - Number(!b.data.code_dir),
);
---

<BaseHtml title="Templates" image="/og/templates.png" searchable={false}>
  <section class="transition-page section-shell min-h-screen pt-28 pb-16">
    <header class="mb-9" data-reveal>
      <h1 class="text-3xl font-bold tracking-tight md:text-5xl">
        Apps you can run, then copy.
      </h1>
      <p class="text-muted-foreground mt-3 max-w-2xl md:text-lg">
        Complete multi-screen Flutter apps. Use each one in your browser, then
        copy the source and connect your own backend.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        templates.map((template, index) => (
          <a
            href={`/templates/${template.id}/`}
            class="border-border bg-card interactive-card group flex flex-col overflow-hidden rounded-2xl border"
            style={`--delay:${Math.min(index * 35, 260)}ms`}
            data-reveal
            data-swup-preload
          >
            <div class="bg-background aspect-[16/10] overflow-hidden">
              {template.data.heroImage && (
                <Image
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                  src={template.data.heroImage}
                  alt={template.data.title}
                />
              )}
            </div>
            <div class="p-5">
              <h2 class="group-hover:text-primary text-lg font-semibold tracking-tight transition-colors">
                {template.data.title}
              </h2>
              <p class="text-muted-foreground mt-1.5 text-sm">
                {template.data.summary}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-10 text-sm">
      Templates with a real backend, payments and auth connected are in the
      works.{" "}
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary font-medium hover:underline"
      >
        Watch on GitHub
      </a>
    </p>
  </section>
  <Footer />
</BaseHtml>
