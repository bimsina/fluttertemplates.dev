---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import { previewWasmUrl } from "@/lib/previewBundle";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // Title shown in site search; lets results say what kind of page they are.
  searchTitle?: string;
  // Listing pages are left out of site search.
  searchable?: boolean;
  // Set on pages that show a live preview near the top.
  preloadPreview?: boolean;
}
const {
  title,
  description,
  image = "/og.png",
  searchTitle,
  searchable = true,
  preloadPreview = false,
} = Astro.props;
// In dev the preview comes from the Flutter dev server instead.
const wasmUrl = preloadPreview && import.meta.env.PROD ? previewWasmUrl() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title ?? SITE_TITLE}
      description={description ?? SITE_DESCRIPTION}
      image={image}
    />
    {searchTitle && <meta data-pagefind-meta={`title:${searchTitle}`} />}
    {
      // The preview iframe only starts loading after hydration; this starts the
      // largest download with the page and the iframe picks it up from cache.
      wasmUrl && (
        <link
          rel="preload"
          href={wasmUrl}
          as="fetch"
          type="application/wasm"
          crossorigin
        />
      )
    }
  </head>
  <body>
    <Header />
    <main id="swup" data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
  </body>
</html>
