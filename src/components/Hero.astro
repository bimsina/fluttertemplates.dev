---
import { Icon } from "astro-icon/components";
import { GITHUB_URL } from "@/consts";
---

<section class="transition-page section-shell pt-28 pb-8 md:pt-26 md:pb-12">
  <div class="surface relative overflow-hidden p-7 md:p-12" data-reveal>
    <div class="relative max-w-3xl">
      <span
        class="border-border bg-background/70 text-muted-foreground inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold"
      >
        <Icon name="mdi:flash" class="text-primary h-3.5 w-3.5" />
        Open-source UI kits for Flutter
      </span>

      <h1
        class="mt-5 text-4xl leading-tight font-bold md:text-6xl"
        style="--delay: 80ms"
        data-reveal
      >
        Modern Flutter UI,
        <span class="text-gradient">without the boilerplate.</span>
      </h1>

      <p
        class="text-muted-foreground mt-5 max-w-2xl text-base md:text-lg"
        style="--delay: 150ms"
        data-reveal
      >
        Explore polished widgets and full templates you can ship with. Minimal,
        production-focused, and ready to customize.
      </p>

      <div
        class="mt-8 flex flex-col gap-3 sm:flex-row"
        style="--delay: 220ms"
        data-reveal
      >
        <a
          href="/widgets"
          class="interactive-button bg-primary text-primary-foreground inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold hover:opacity-90"
          data-swup-preload
        >
          Browse Widgets
          <Icon name="mdi:arrow-right" class="interactive-icon-shift h-4 w-4" />
        </a>
        <a
          href={GITHUB_URL}
          class="interactive-button border-border bg-card text-foreground hover:bg-muted inline-flex items-center justify-center gap-2 rounded-xl border px-5 py-3 text-sm font-semibold"
          target="_blank"
          rel="noreferrer noopener"
        >
          <Icon name="mdi:github" class="h-4 w-4" />
          View Repository
        </a>
      </div>
    </div>
  </div>
</section>
