---
import type { WidgetGroupType } from "@/types";
import WidgetsNavGroup from "./WidgetsNavSidebar.astro";
import { Icon } from "astro-icon/components";

interface Props {
  group: WidgetGroupType;
  currentPath?: string;
  isNested?: boolean;
  expandOnLoad?: boolean;
}

const { group, currentPath = "", isNested = false, expandOnLoad = true } =
  Astro.props;

const groupId = group.indexFile?.id ?? group.path;

function groupContainsPath(g: WidgetGroupType, path: string): boolean {
  const id = g.indexFile?.id ?? g.path;
  if (path === id || path.startsWith(id + "/")) return true;
  return !!g.children?.some((c) => groupContainsPath(c, path));
}
const groupTitle = group.indexFile?.data?.title ?? group.title ?? "";

function isGroupActive(g: WidgetGroupType, path: string): boolean {
  const id = g.indexFile?.id ?? g.path;
  return path === id || path.startsWith(id + "/");
}

function isItemActive(itemId: string, path: string): boolean {
  return path === itemId;
}
---

{
  group.indexFile &&
    (group.items.length > 0 ||
      (group.children && group.children.length > 0)) && (
      <ul class="pl-0 pt-2">
        <li
          data-group-id={groupId}
          data-group-title={groupTitle}
          class:list={[
            !isNested && "border-b border-border pb-2 mb-2",
            isGroupActive(group, currentPath) && "sidebar-group-active",
          ]}
        >
          <div class="group-header">
            <div class="flex items-center justify-between w-full">
              <a
                href={"/widgets/" + group.indexFile.id}
                class="group-header-link flex-1 font-medium px-4 py-3 text-foreground flex items-center gap-2 hover:bg-muted/50 rounded-md transition-colors cursor-pointer"
              >
                {group.indexFile.data.icon && (
                  <Icon
                    name={group.indexFile.data.icon}
                    class="size-4 shrink-0"
                  />
                )}
                <span class="truncate">{group.indexFile.data.title}</span>
              </a>
              <button
                class="p-2 text-foreground hover:bg-muted/50 rounded-md transition-colors cursor-pointer"
                data-collapse-target={`group-${groupId}`}
                aria-expanded={expandOnLoad ? "true" : "false"}
                aria-label="Toggle section"
              >
                <Icon
                  name="mdi:chevron-down"
                  class="size-4 shrink-0 transition-transform duration-200"
                  data-chevron
                  style={{
                    transform: expandOnLoad ? "rotate(180deg)" : "rotate(0deg)",
                  }}
                />
              </button>
            </div>
          </div>

          <div
            class="overflow-hidden transition-all duration-200 ease-in-out"
            data-collapse-content={`group-${groupId}`}
            style={expandOnLoad ? "max-height: 1000px;" : "max-height: 0;"}
          >
            <ul class={"pl-4 space-y-1 " + (!isNested ? "" : "")}>
              {group.items
                .filter((item) => !item.filePath?.endsWith("index.md"))
                .map((item) => (
                  <li>
                    <a
                      href={`/widgets/${item.id}`}
                      data-item-id={item.id}
                      data-item-title={item.data.title}
                      class:list={[
                        "px-2 py-2 rounded-md hover:bg-muted/50 text-foreground flex items-center gap-2 transition-colors",
                        isItemActive(item.id, currentPath) && "sidebar-active",
                      ]}
                    >
                      {item.data.icon && (
                        <Icon name={item.data.icon} class="size-4 shrink-0" />
                      )}
                      <span class="truncate">{item.data.title}</span>
                    </a>
                  </li>
                ))}
              {group.children?.map((childGroup) => (
                <li>
                  <WidgetsNavGroup
                    group={childGroup}
                    currentPath={currentPath}
                    isNested
                    expandOnLoad={groupContainsPath(childGroup, currentPath)}
                  />
                </li>
              ))}
            </ul>
          </div>
        </li>
      </ul>
    )
}

<script>
  document.querySelectorAll("[data-collapse-target]").forEach((button) => {
    button.addEventListener("click", () => {
      const targetId = button.getAttribute("data-collapse-target");
      const content = document.querySelector(
        `[data-collapse-content="${targetId}"]`,
      );
      const chevron = button.querySelector("[data-chevron]");
      const isExpanded = button.getAttribute("aria-expanded") === "true";

      button.setAttribute("aria-expanded", String(!isExpanded));
      if (chevron instanceof SVGElement) {
        chevron.style.transform = isExpanded ? "rotate(0deg)" : "rotate(180deg)";
      }

      if (content instanceof HTMLElement) {
        if (isExpanded) {
          content.style.maxHeight = "0";
        } else {
          content.style.maxHeight = `${content.scrollHeight}px`;
        }
      }
    });
  });
</script>
