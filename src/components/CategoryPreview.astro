---
import { Icon } from "astro-icon/components";

interface Props {
  slug: string;
  icon?: string;
}

const { slug, icon } = Astro.props;
const bars = [42, 62, 48, 80, 60, 92, 78];
const known = [
  "core",
  "chat",
  "communication",
  "animation",
  "layouts",
  "forms",
  "overlays",
  "states",
  "ecommerce",
  "social",
  "search",
  "finance",
  "food",
  "health",
  "education",
  "travel",
  "media",
  "dashboard",
  "gallery",
  "calendar",
  "notifications",
  "pricing",
  "profile",
  "must_haves",
  "info",
  "utilities",
  "navigation",
];
---

<div class="bg-background relative h-40 overflow-hidden p-4">
  {
    slug === "core" && (
      <div class="flex h-full flex-col justify-center gap-3">
        <div class="flex items-center gap-2.5">
          <span class="bg-primary text-primary-foreground rounded-lg px-3 py-1.5 text-[0.68rem] font-semibold">
            Button
          </span>
          <span class="bg-primary flex h-5 w-9 items-center rounded-full px-0.5">
            <span class="bg-primary-foreground h-4 w-4 rounded-full transition-transform duration-300 ease-out motion-safe:group-hover:translate-x-4" />
          </span>
          <span class="bg-primary text-primary-foreground flex h-5 w-5 items-center justify-center rounded">
            <Icon name="mdi:check" class="size-3.5" />
          </span>
        </div>
        <div class="bg-muted relative h-1.5 w-full rounded-full">
          <div class="bg-primary h-1.5 w-2/5 rounded-full transition-[width] duration-500 ease-out motion-safe:group-hover:w-3/5" />
          <span class="border-background bg-primary absolute top-1/2 left-2/5 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 transition-[left] duration-500 ease-out motion-safe:group-hover:left-3/5" />
        </div>
      </div>
    )
  }

  {
    slug === "chat" && (
      <div class="flex h-full flex-col justify-center gap-2">
        <div class="bg-secondary text-secondary-foreground max-w-[78%] rounded-2xl rounded-bl-md px-3 py-2 text-[0.72rem]">
          Is the design system ready?
        </div>
        <div class="bg-primary text-primary-foreground ml-auto max-w-[78%] rounded-2xl rounded-br-md px-3 py-2 text-[0.72rem]">
          Shipping it now
        </div>
        <div class="bg-muted text-muted-foreground mt-1 flex items-center justify-between rounded-full px-3 py-1.5 font-mono text-[0.66rem]">
          Message…
          <Icon
            name="mdi:send"
            class="text-muted-foreground motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
          />
        </div>
      </div>
    )
  }

  {
    slug === "communication" && (
      <div class="flex h-full flex-col items-center justify-center gap-2.5">
        <span class="bg-accent h-12 w-12 rounded-full" />
        <div class="bg-muted h-1.5 w-16 rounded-full" />
        <div class="flex gap-2.5">
          <span class="bg-primary text-primary-foreground flex h-8 w-8 items-center justify-center rounded-full transition duration-300 motion-safe:group-hover:brightness-110">
            <Icon name="mdi:phone" class="size-4" />
          </span>
          <span class="bg-muted text-muted-foreground flex h-8 w-8 items-center justify-center rounded-full">
            <Icon name="mdi:microphone-off" class="size-4" />
          </span>
          <span class="bg-destructive text-destructive-foreground flex h-8 w-8 items-center justify-center rounded-full">
            <Icon name="mdi:phone-hangup" class="size-4" />
          </span>
        </div>
      </div>
    )
  }

  {
    slug === "animation" && (
      <div class="relative flex h-full items-center justify-center">
        <span
          class="ft-ripple border-primary absolute inset-0 m-auto h-10 w-10 rounded-full border-2"
          style="animation-delay:0s"
        />
        <span
          class="ft-ripple border-primary absolute inset-0 m-auto h-10 w-10 rounded-full border-2"
          style="animation-delay:0.8s"
        />
        <span
          class="ft-ripple border-primary absolute inset-0 m-auto h-10 w-10 rounded-full border-2"
          style="animation-delay:1.6s"
        />
        <span class="ft-core bg-primary text-primary-foreground relative z-10 flex h-11 w-11 items-center justify-center rounded-full">
          <Icon name="mdi:play" class="size-5" />
        </span>
      </div>
    )
  }

  {
    slug === "layouts" && (
      <div class="grid h-full grid-cols-3 grid-rows-2 gap-2">
        <span class="bg-accent row-span-2 rounded-lg" />
        <span class="bg-muted motion-safe:group-hover:bg-secondary rounded-lg transition-colors duration-300" />
        <span class="bg-secondary rounded-lg" />
        <span class="bg-muted motion-safe:group-hover:bg-secondary col-span-2 rounded-lg transition-colors delay-75 duration-300" />
      </div>
    )
  }

  {
    slug === "forms" && (
      <div class="flex h-full flex-col justify-center gap-2">
        <div class="bg-muted text-muted-foreground rounded-lg px-2.5 py-2 font-mono text-[0.64rem]">
          Full name
        </div>
        <div
          class="border-primary bg-card rounded-lg border px-2.5 py-2 font-mono text-[0.64rem]"
          style="box-shadow:0 0 0 3px var(--accent)"
        >
          jane@studio.dev
        </div>
        <div class="bg-primary text-primary-foreground rounded-lg py-2 text-center text-[0.66rem] font-semibold transition duration-300 motion-safe:group-hover:brightness-110">
          Create account
        </div>
      </div>
    )
  }

  {
    slug === "overlays" && (
      <div class="bg-muted relative h-full overflow-hidden rounded-lg">
        <div class="bg-card absolute inset-x-2 bottom-0 rounded-t-2xl p-3 transition-transform duration-300 ease-out motion-safe:translate-y-2 motion-safe:group-hover:translate-y-0">
          <div class="bg-muted-foreground/30 mx-auto h-1 w-8 rounded-full" />
          <div class="bg-muted mt-2.5 h-2 w-2/3 rounded" />
          <div class="bg-muted mt-1.5 h-1.5 w-1/2 rounded opacity-70" />
          <div class="bg-primary text-primary-foreground mt-2.5 rounded-lg py-1.5 text-center text-[0.64rem] font-semibold">
            Confirm
          </div>
        </div>
      </div>
    )
  }

  {
    slug === "states" && (
      <div class="flex h-full flex-col items-center justify-center gap-2 text-center">
        <div class="bg-accent text-accent-foreground motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-300">
          <Icon name="mdi:inbox-outline" class="size-5" />
        </div>
        <div class="bg-muted h-2 w-28 rounded" />
        <div class="bg-muted h-1.5 w-20 rounded opacity-70" />
      </div>
    )
  }

  {
    slug === "ecommerce" && (
      <div class="grid h-full grid-cols-2 content-center gap-2.5">
        <div class="bg-card overflow-hidden rounded-xl">
          <div
            class="h-12 transition-transform duration-500 ease-out motion-safe:group-hover:scale-105"
            style="background:#E0654B"
          />
          <div class="p-2">
            <div class="bg-muted h-1.5 w-3/4 rounded" />
            <div class="mt-1.5 flex items-center justify-between">
              <span class="font-mono text-[0.62rem] font-semibold">$48</span>
              <span class="bg-primary h-3.5 w-3.5 rounded" />
            </div>
          </div>
        </div>
        <div class="bg-card overflow-hidden rounded-xl">
          <div class="bg-primary h-12 transition-transform delay-75 duration-500 ease-out motion-safe:group-hover:scale-105" />
          <div class="p-2">
            <div class="bg-muted h-1.5 w-2/3 rounded" />
            <div class="mt-1.5 flex items-center justify-between">
              <span class="font-mono text-[0.62rem] font-semibold">$92</span>
              <span class="bg-primary h-3.5 w-3.5 rounded" />
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    slug === "social" && (
      <div class="bg-card flex h-full flex-col justify-center rounded-xl p-3">
        <div class="flex items-center gap-2">
          <span class="bg-accent h-6 w-6 rounded-full" />
          <div class="bg-muted h-1.5 w-16 rounded" />
        </div>
        <div class="mt-2 h-12 rounded-lg" style="background:#4A73C4" />
        <div class="text-muted-foreground mt-2 flex gap-3">
          <Icon
            name="mdi:heart-outline"
            class="motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
          />
          <Icon name="mdi:comment-outline" class="size-3.5" />
          <Icon name="mdi:share-outline" class="size-3.5" />
        </div>
      </div>
    )
  }

  {
    slug === "search" && (
      <div class="flex h-full flex-col justify-center gap-2">
        <div class="bg-muted text-muted-foreground flex items-center gap-2 rounded-full px-3 py-2 font-mono text-[0.66rem]">
          <Icon
            name="mdi:magnify"
            class="motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
          />
          Search widgets…
        </div>
        {[70, 52].map((w) => (
          <div class="flex items-center gap-2.5 px-1">
            <Icon name="mdi:history" class="text-muted-foreground size-3.5" />
            <div class="bg-muted h-1.5 rounded" style={`width:${w}%`} />
          </div>
        ))}
      </div>
    )
  }

  {
    slug === "finance" && (
      <div class="flex h-full flex-col justify-center">
        <div class="text-muted-foreground text-[0.58rem] font-semibold uppercase">
          Total balance
        </div>
        <div class="text-xl font-bold tabular-nums">$12,840</div>
        <div class="mt-3 flex h-10 items-end gap-1.5">
          {bars.map((h, i) => (
            <span
              class={`flex-1 rounded-t transition-colors duration-300 ease-out ${i === 3 ? "bg-primary" : "bg-muted motion-safe:group-hover:bg-primary/40"}`}
              style={`height:${h}%;transition-delay:${i * 40}ms`}
            />
          ))}
        </div>
      </div>
    )
  }

  {
    slug === "food" && (
      <div class="flex h-full flex-col justify-center gap-3">
        {[
          { c: "#EAB94D", n: "Saffron Kitchen", s: "★ 4.8 · 25 min · $$" },
          { c: "#2F9E6E", n: "Green Bowl", s: "★ 4.6 · 18 min · $" },
        ].map((r) => (
          <div class="flex items-center gap-2.5">
            <span
              class="h-10 w-10 flex-none rounded-xl transition duration-300 motion-safe:group-hover:brightness-105"
              style={`background:${r.c}`}
            />
            <div>
              <div class="text-[0.78rem] font-semibold">{r.n}</div>
              <div class="text-muted-foreground mt-0.5 font-mono text-[0.6rem]">
                {r.s}
              </div>
            </div>
          </div>
        ))}
      </div>
    )
  }

  {
    slug === "health" && (
      <div class="flex h-full items-center justify-center gap-4">
        <div
          class="relative h-20 w-20 rounded-full"
          style="background:conic-gradient(var(--primary) 72%, var(--muted) 0)"
        >
          <div class="bg-background absolute inset-[7px] flex items-center justify-center rounded-full text-[0.72rem] font-bold">
            72%
          </div>
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="bg-accent text-accent-foreground motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground rounded-md px-2 py-1 text-[0.6rem] font-semibold transition-colors duration-300">
            8,240 steps
          </span>
          <span class="bg-secondary text-secondary-foreground rounded-md px-2 py-1 text-[0.6rem] font-semibold">
            62 bpm
          </span>
        </div>
      </div>
    )
  }

  {
    slug === "education" && (
      <div class="flex h-full flex-col justify-center gap-3">
        <div class="flex items-center gap-2.5">
          <span class="bg-accent text-accent-foreground motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground flex h-9 w-9 flex-none items-center justify-center rounded-lg transition-colors duration-300">
            <Icon name="mdi:play" class="size-4" />
          </span>
          <div class="flex-1">
            <div class="bg-muted h-2 w-2/3 rounded" />
            <div class="bg-muted mt-1.5 h-1.5 w-full overflow-hidden rounded-full">
              <div class="bg-primary h-1.5 w-3/5 rounded-full transition-[width] duration-500 ease-out motion-safe:group-hover:w-[85%]" />
            </div>
          </div>
          <span class="text-muted-foreground font-mono text-[0.6rem]">3/5</span>
        </div>
        <div class="flex gap-2">
          <span class="bg-secondary text-secondary-foreground rounded-md px-2 py-1 text-[0.58rem] font-semibold">
            Quiz
          </span>
          <span class="bg-accent text-accent-foreground rounded-md px-2 py-1 text-[0.58rem] font-semibold">
            Flashcards
          </span>
        </div>
      </div>
    )
  }

  {
    slug === "travel" && (
      <div class="flex h-full flex-col justify-center">
        <div class="relative overflow-hidden rounded-xl">
          <div
            class="h-24 transition-transform duration-500 ease-out motion-safe:group-hover:scale-105"
            style="background:#39A7C4"
          />
          <span class="bg-card/90 absolute top-2 left-2 rounded-full px-2 py-0.5 text-[0.58rem] font-semibold">
            ★ 4.9
          </span>
          <span class="absolute bottom-2 left-2 text-[0.72rem] font-bold text-white">
            Kyoto, Japan
          </span>
          <span class="bg-primary text-primary-foreground absolute right-2 bottom-2 rounded-full px-2 py-0.5 text-[0.58rem] font-semibold">
            $1,240
          </span>
        </div>
      </div>
    )
  }

  {
    slug === "media" && (
      <div class="bg-card flex h-full items-center gap-2.5 rounded-xl p-3">
        <span
          class="h-12 w-12 flex-none rounded-lg"
          style="background:#8B5BEF"
        />
        <div class="flex-1">
          <div class="bg-muted h-2 w-2/3 rounded" />
          <div class="bg-muted mt-1 h-1.5 w-1/3 rounded opacity-70" />
          <div class="bg-muted mt-2 h-1 w-full overflow-hidden rounded">
            <div class="bg-primary h-1 w-1/2 rounded transition-[width] duration-500 ease-out motion-safe:group-hover:w-4/5" />
          </div>
        </div>
        <span class="bg-primary text-primary-foreground flex h-7 w-7 flex-none items-center justify-center rounded-full transition duration-300 motion-safe:group-hover:brightness-110">
          <Icon name="mdi:play" class="size-3.5" />
        </span>
      </div>
    )
  }

  {
    slug === "dashboard" && (
      <div class="grid h-full grid-cols-2 content-center gap-2">
        <div class="bg-card rounded-xl p-2.5">
          <div class="text-muted-foreground text-[0.56rem] font-semibold uppercase">
            MRR
          </div>
          <div class="mt-0.5 text-base font-bold tabular-nums">$8.4k</div>
        </div>
        <div class="bg-card rounded-xl p-2.5">
          <div class="text-muted-foreground text-[0.56rem] font-semibold uppercase">
            Active
          </div>
          <div class="mt-0.5 text-base font-bold tabular-nums">1,204</div>
        </div>
        <div class="col-span-2 flex h-8 items-end gap-1.5">
          {bars.map((h, i) => (
            <span
              class="bg-primary flex-1 rounded-t opacity-70 transition-opacity duration-300 ease-out motion-safe:group-hover:opacity-100"
              style={`height:${h}%;transition-delay:${i * 40}ms`}
            />
          ))}
        </div>
      </div>
    )
  }

  {
    slug === "gallery" && (
      <div class="grid h-full grid-cols-3 grid-rows-2 gap-1.5">
        {["#E0654B", "#2F9E6E", "#4A73C4", "#EAB94D", "#8B5BEF", "#39A7C4"].map(
          (c, i) => (
            <span
              class="rounded-md opacity-90 transition-opacity duration-300 ease-out motion-safe:group-hover:opacity-100"
              style={`background:${c};transition-delay:${i * 30}ms`}
            />
          ),
        )}
      </div>
    )
  }

  {
    slug === "calendar" && (
      <div class="bg-card flex h-full flex-col justify-center rounded-xl p-3">
        <div class="mb-2 flex items-baseline justify-between">
          <span class="text-[0.7rem] font-semibold">July</span>
          <span class="text-muted-foreground font-mono text-[0.58rem]">
            2026
          </span>
        </div>
        <div class="grid grid-cols-7 justify-items-center gap-1.5">
          {Array.from({ length: 35 }).map((_, i) => (
            <span
              class={`h-2.5 w-2.5 rounded-[3px] transition-colors duration-300 ${i === 16 ? "bg-primary" : "bg-muted motion-safe:group-hover:bg-secondary"}`}
            />
          ))}
        </div>
      </div>
    )
  }

  {
    slug === "notifications" && (
      <div class="flex h-full flex-col justify-center gap-2">
        {[true, false, false].map((unread) => (
          <div class="bg-card flex items-center gap-2.5 rounded-xl px-2.5 py-2">
            <span
              class={`flex h-7 w-7 flex-none items-center justify-center rounded-lg transition-colors duration-300 ${unread ? "bg-accent text-accent-foreground motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground" : "bg-accent text-accent-foreground"}`}
            >
              <Icon name="mdi:bell-outline" class="size-3.5" />
            </span>
            <div class="flex-1">
              <div class="bg-muted h-1.5 w-3/4 rounded" />
              <div class="bg-muted mt-1 h-1.5 w-1/2 rounded opacity-70" />
            </div>
            {unread && (
              <span class="bg-primary h-2 w-2 flex-none rounded-full" />
            )}
          </div>
        ))}
      </div>
    )
  }

  {
    slug === "pricing" && (
      <div class="grid h-full grid-cols-2 content-center gap-2.5">
        <div class="bg-card rounded-xl p-2.5">
          <div class="text-muted-foreground text-[0.56rem] font-semibold uppercase">
            Starter
          </div>
          <div class="mt-0.5 text-sm font-bold tabular-nums">$9</div>
          <div class="bg-muted mt-2 h-1.5 w-full rounded" />
          <div class="bg-muted mt-1.5 h-1.5 w-2/3 rounded opacity-70" />
        </div>
        <div class="border-primary bg-card rounded-xl border-2 p-2.5">
          <div class="text-primary text-[0.56rem] font-semibold uppercase">
            Pro
          </div>
          <div class="mt-0.5 text-sm font-bold tabular-nums">$29</div>
          <div class="bg-muted mt-2 h-1.5 w-full rounded" />
          <div class="bg-primary mt-1.5 h-1.5 w-3/4 rounded transition-[width] duration-500 ease-out motion-safe:group-hover:w-full" />
        </div>
      </div>
    )
  }

  {
    slug === "profile" && (
      <div class="flex h-full flex-col justify-center gap-3">
        <div class="flex items-center gap-2.5">
          <span class="bg-accent h-10 w-10 flex-none rounded-full" />
          <div>
            <div class="bg-muted h-2 w-20 rounded" />
            <div class="bg-muted mt-1.5 h-1.5 w-14 rounded opacity-70" />
          </div>
        </div>
        {[0, 1].map(() => (
          <div class="bg-card flex items-center justify-between rounded-lg px-2.5 py-2">
            <span class="bg-muted h-1.5 w-16 rounded" />
            <Icon
              name="mdi:chevron-right"
              class="text-muted-foreground motion-safe:group-hover:text-primary size-3.5 transition-colors duration-300"
            />
          </div>
        ))}
      </div>
    )
  }

  {
    slug === "must_haves" && (
      <div class="flex h-full flex-col items-center justify-center gap-2.5 text-center">
        <div class="bg-accent text-accent-foreground motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground flex h-14 w-14 items-center justify-center rounded-2xl transition-colors duration-300">
          <Icon name="mdi:rocket-launch-outline" class="size-6" />
        </div>
        <div class="flex gap-1">
          <span class="bg-primary h-1.5 w-4 rounded-full" />
          <span class="bg-muted motion-safe:group-hover:bg-primary/50 h-1.5 w-1.5 rounded-full transition-colors duration-300" />
          <span class="bg-muted h-1.5 w-1.5 rounded-full" />
        </div>
        <span class="bg-primary text-primary-foreground rounded-full px-4 py-1.5 text-[0.64rem] font-semibold transition duration-300 motion-safe:group-hover:brightness-110">
          Get started
        </span>
      </div>
    )
  }

  {
    slug === "info" && (
      <div class="flex h-full flex-col justify-center gap-2">
        <div class="bg-card rounded-xl p-2.5">
          <div class="flex items-center justify-between">
            <div class="bg-muted h-2 w-2/3 rounded" />
            <Icon
              name="mdi:chevron-up"
              class="text-muted-foreground size-3.5"
            />
          </div>
          <div class="bg-muted mt-2 h-1.5 w-full rounded opacity-70" />
          <div class="bg-muted mt-1 h-1.5 w-4/5 rounded opacity-70" />
        </div>
        <div class="bg-card flex items-center justify-between rounded-xl p-2.5">
          <div class="bg-muted h-2 w-1/2 rounded" />
          <Icon
            name="mdi:chevron-down"
            class="text-muted-foreground size-3.5 transition-transform duration-300 ease-out motion-safe:group-hover:rotate-180"
          />
        </div>
      </div>
    )
  }

  {
    slug === "utilities" && (
      <div class="grid h-full grid-cols-2 content-center gap-2">
        <div class="bg-card flex items-center gap-2 rounded-xl p-2.5">
          <Icon name="mdi:weather-partly-cloudy" class="text-primary size-5" />
          <span class="text-sm font-bold tabular-nums">24°</span>
        </div>
        <div class="bg-card flex items-center gap-2 rounded-xl p-2.5">
          <Icon
            name="mdi:calculator-variant-outline"
            class="text-primary size-5"
          />
          <span class="bg-muted h-1.5 w-10 rounded" />
        </div>
        <div class="bg-card flex items-center gap-2 rounded-xl p-2.5">
          <Icon name="mdi:clock-outline" class="text-primary size-5" />
          <span class="font-mono text-[0.66rem] font-semibold">09:41</span>
        </div>
        <div class="bg-card flex items-center gap-2 rounded-xl p-2.5">
          <Icon name="mdi:note-outline" class="text-primary size-5" />
          <span class="bg-muted h-1.5 w-10 rounded" />
        </div>
      </div>
    )
  }

  {
    slug === "navigation" && (
      <div class="flex h-full flex-col justify-center gap-2">
        <div class="bg-card flex-1 rounded-xl p-2.5">
          <div class="bg-muted h-2 w-1/2 rounded" />
